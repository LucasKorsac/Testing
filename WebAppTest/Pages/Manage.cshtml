@page
@model WebAppTest.Pages.ManageModel
@{
    ViewData["Title"] = "Справка";
}

@section Styles {
    <link rel="stylesheet" href="~/css/manage.css" />
}

<main class="page-container">
    <h1> Руководство пользователя</h1>
    <p class="page-description">Система A/B тестирования для анализа и оптимизации игровых механик</p>

    <!-- Руководство по работе с сайтом -->

    <section class="help-section">
        <h2>1. Принцип работы сайта</h2>

        <h3>1.1. Что такое A/B тестирование?</h3>
        <p>A/B тестирование — это метод маркетингового исследования, при котором сравниваются две или более версии одного продукта (варианта А и Б) для определения, какая из них работает лучше. В контексте игровой индустрии это позволяет проверять гипотезы о влиянии изменений в игровых механиках на поведение пользователей.</p>

        <h3>1.2. Архитектура системы</h3>
        <p>Система состоит из трех основных компонентов:</p>
        <ul>
            <li><strong>Клиентская библиотека (ABLibrary)</strong> — встраивается в игровой проект на Unity, собирает телеметрию и отправляет на сервер</li>
            <li><strong>Серверное приложение (WebAppTest)</strong> — обрабатывает запросы, управляет тестами и хранит данные</li>
            <li><strong>База данных (MongoDB)</strong> — хранит информацию о тестах, вариантах, результатах и метриках</li>
        </ul>

        <h3>1.3. Процесс проведения A/B теста</h3>
        <ol>
            <li><strong>Создание теста</strong> — разработчик создает тест через веб-интерфейс, указывает название, описание и варианты</li>
            <li><strong>Интеграция библиотеки</strong> — в игровой проект добавляется ABLibrary и настраивается подключение к серверу</li>
            <li><strong>Сбор данных</strong> — игра отправляет события о действиях пользователей (конверсии, изменения эмоций, выборы)</li>
            <li><strong>Анализ результатов</strong> — через веб-интерфейс можно просматривать статистику и графики</li>
            <li><strong>Принятие решения</strong> — на основе полученных данных разработчик выбирает лучший вариант</li>
        </ol>
    </section>

    <!-- Стратегии распределения -->

    <section class="help-section">
        <h2>2. Стратегии распределения пользователей</h2>
        <p>Система поддерживает несколько стратегий распределения трафика между вариантами теста:</p>

        <div class="strategy-card">
            <h3> Случайная/Random</h3>
            <p>Пользователи равномерно распределяются между вариантами. Классический подход A/B тестирования.</p>
            <p><strong>Когда использовать:</strong> Для точной статистики, когда важна достоверность результатов</p>
        </div>

        <div class="strategy-card">
            <h3> Адаптивная/Adaptive</h3>
            <p>Трафик перераспределяется в пользу вариантов с лучшими показателями. Основана на квадратичном взвешивании вариантов с пороговой фильтрацией выборок.</p>
            <p><strong>Когда использовать:</strong> Для быстрого получения оптимального варианта, когда цена ошибки невысока</p>
        </div>

        <div class="strategy-card">
            <h3> Выборка Томпсона/Thompson Sampling</h3>
            <p>Балансирует исследование и эксплуатацию с использованием бета-распределения. Постоянно исследует варианты, но отдает предпочтение лучшим.</p>
            <p><strong>Когда использовать:</strong> Для динамических сред, где поведение пользователей меняется со временем</p>
        </div>

        <div class="strategy-card">
            <h3> Верхняя граница доверительного интервала/Upper Confidence Bound</h3>
            <p>Выбирает вариант с максимальной верхней границей доверительного интервала. Математически гарантирует минимальное сожаление.</p>
            <p><strong>Когда использовать:</strong> Когда важна теоретическая гарантия качества</p>
        </div>

        <div class="strategy-card">
            <h3> Эпсилон-Жадный/Epsilon-Greedy </h3>
            <p>С вероятностью ε исследует случайный вариант, с вероятностью 1-ε выбирает лучший из известных.</p>
            <p><strong>Когда использовать:</strong> Простой и эффективный подход для большинства задач</p>
        </div>

        <h3>Рекомендации по выбору стратегии</h3>
        <ul>
            <li><strong>Random</strong> — для точных научных экспериментов, где важна статистическая значимость</li>
            <li><strong>Adapt</strong> — для быстрого тестирования большого количества вариантов</li>
            <li><strong>Thompson Sampling</strong> — для задач с бинарными метриками (конверсия)</li>
            <li><strong>UCB</strong> — для задач с непрерывными метриками (время в игре, количество действий)</li>
            <li><strong>Epsilon-Greedy</strong> — универсальный выбор, хорош для начала</li>
        </ul>
    </section>

    <!-- Руководство по использованию сайта -->

    <section class="help-section">
        <h2>3. Руководство по использованию сайта</h2>

        <h3>3.1. Главная страница</h3>
        <p>На главной странице отображается:</p>
        <ul>
            <li><strong>Общая аналитика</strong> — общее количество тестов, вариантов, установок</li>
            <li><strong>График активности</strong> — динамика создания тестов, вариантов и приложений</li>
            <li><strong>Активные тесты</strong> — список запущенных тестов с возможностью перехода к деталям</li>
        </ul>

        <h3>3.2. Управление тестами (TestControl)</h3>
        <p>На странице управления тестами можно:</p>
        <ul>
            <li><strong>Создать тест</strong> — указать название, описание, выбрать приложение и добавить варианты через запятую</li>
            <li><strong>Редактировать тест</strong> — изменить название, описание или статус теста</li>
            <li><strong>Остановить/Запустить тест</strong> — временно приостановить или возобновить сбор данных</li>
            <li><strong>Удалить тест</strong> — полностью удалить тест и все связанные данные</li>
        </ul>

        <h3>3.3. Страница теста (Tests)</h3>
        <p>На странице конкретного теста доступны:</p>
        <ul>
            <li><strong>Общая информация</strong> — название, описание, статус, выбранная стратегия</li>
            <li><strong>Статистика</strong> — количество вариантов и установок</li>
            <li><strong>График</strong> — визуализация установок и метрик по вариантам (можно переключать тип графика)</li>
            <li><strong>Экспорт данных</strong> — возможность выгрузить результаты в Excel или TXT</li>
            <li><strong>Выбор стратегии</strong> — изменение стратегии распределения для теста</li>
        </ul>

        <h3>3.4. Управление приложениями (Apps)</h3>
        <p>На странице приложений можно:</p>
        <ul>
            <li><strong>Создать приложение</strong> — добавить новое приложение в систему</li>
            <li><strong>Редактировать приложение</strong> — изменить название или описание</li>
            <li><strong>Удалить приложение</strong> — удалить приложение и все связанные с ним тесты</li>
            <li><strong>Управлять экземплярами</strong> — добавлять, редактировать и удалять версии приложения</li>
        </ul>

        <h3>3.5. Страница экземпляра (InstanceDetail)</h3>
        <p>На странице экземпляра отображается:</p>
        <ul>
            <li><strong>Информация о версии</strong> — название и номер версии</li>
            <li><strong>График распределения метрик</strong> — частота встречаемости значений метрик</li>
            <li><strong>Таблица метрик</strong> — детальные данные по каждому результату</li>
        </ul>
    </section>


    <!-- Руководство по использовании библиотеки -->

    <section class="help-section">
        <h2>4. Руководство по использованию ABLibrary</h2>

        <h3>4.1. Подключение библиотеки</h3>
        <p>Для использования библиотеки в проекте Unity необходимо:</p>
        <ol>
            <li>Скопировать файл <strong>ABLibrary.dll</strong> в папку <code>Assets/Plugins</code> вашего Unity проекта</li>
            <li>Добавить необходимые пространства имен в код</li>
        </ol>

        <h3>4.2. Инициализация клиента</h3>
        <pre><code>
using ABLibrary.Core;
using ABLibrary.Storage;
using ABLibrary.Transport;

public class ABTestManager : MonoBehaviour
{
    private ABClient _client;
    
    async void Start()
    {
        var transport = new HttpABTransport("http://localhost:5000/");
        var storage = new FileStorageForUnity(Application.persistentDataPath);
        var options = new ABOptions { AutoFlush = true };
        
        _client = new ABClient(transport, storage, options);
        await _client.InitializeAsync("your_game_id");
    }
}
        </code></pre>

        <h3>4.3. Получение варианта теста</h3>
        <pre><code>
string variant = _client.GetVariant("button_color_test");
if (variant == "A")
{
    // Контрольная группа
    buttonImage.color = Color.red;
}
else if (variant == "B")
{
    // Экспериментальная группа
    buttonImage.color = Color.blue;
}
        </code></pre>

        <h3>4.4. Отслеживание конверсии</h3>
        <pre><code>
await _client.TrackAsync("button_color_test", 
    SystemInfo.deviceUniqueIdentifier, 
    "click");
        </code></pre>

        <h3>4.5. Опции конфигурации</h3>
        <pre><code>
var options = new ABOptions 
{ 
    StorageKey = "custom_events", AutoFlush = true               
};
        </code></pre>
    </section>


    <!-- Скачивание библиотеки -->

    <section class="help-section">
        <h2>5. Файл библиотеки</h2>
        <p>Для скачивания ABLibrary.dll нажмите на кнопку ниже:</p>
        <div class="download-area">
            <a href="/download/ABLibrary.dll" class="btn btn-primary" download>
                Скачать ABLibrary.dll
            </a>
        </div>
        <p class="note">Примечание: Файл библиотеки должен быть размещен в папке <code>wwwroot/download/</code> для корректного скачивания.</p>
    </section>

</main>