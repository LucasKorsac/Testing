@page
@model WebAppTest.Pages.IndexModel

@{
    ViewData["Title"] = "Главная";
}

<main class="page-container">

    <h1>Главная страница</h1>

    <section>
        <h2>Общая аналитика</h2>
        <table class="metrics-table">
            <thead>
                <tr>
                    <th>Параметр</th>
                    <th>Значение</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Всего установок</td>
                    <td>@Model.Analytics.TotalUsers</td>
                </tr>
                <tr>
                    <td>Всего тестов</td>
                    <td>@Model.TotalTests</td>
                </tr>
                <tr>
                    <td>Активных тестов</td>
                    <td>@Model.ActiveCount</td>
                </tr>
                <tr>
                    <td>Всего вариантов</td>
                    <td>@Model.TotalVariants</td>
                </tr>
                <tr>
                    <td>Среднее количество установок на тест</td>
                    <td>@Model.Analytics.AvgUsersPerTest.ToString("0.0")</td>
                </tr>
            </tbody>
        </table>
    </section>

    <section class="chart-section">
        <h2>Активность тестов</h2>
        <div class="chart-layout">
            <div class="chart-sidebar">
                <label for="mainChartType">Тип графика</label>
                <select id="mainChartType">
                    <option value="line">Линейный</option>
                    <option value="bar">Столбчатый</option>
                    <option value="pie">Круговой</option>
                </select>
                <label for="metricSelect" style="margin-top: 16px;">Показатель</label>
                <select id="metricSelect">
                    <option value="tests">Количество тестов</option>
                    <option value="variants">Количество вариантов</option>
                    <option value="applications">Количество приложений</option>
                </select>
            </div>
            <div class="chart-wrapper">
                <canvas id="testsChart" style="width:100%; height:400px;"></canvas>
            </div>
        </div>
    </section>

    <section>
        <h2>Активные тесты</h2>
        @if (Model.ActiveTests.Any())
        {
            <table class="metrics-table">
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Кол-во вариантов</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.ActiveTests)
                    {
                        <tr>
                            <td><a href="/Tests/@t.Id">@t.Name</a></td>
                            <td>@(Model.VariantsPerTest.ContainsKey(t.Id) ? Model.VariantsPerTest[t.Id] : 0)</td>
                            <td><span class="status-badge @(t.Enabled ? "status-active" : "status-stopped")">@(t.Enabled ? "Активен" : "Остановлен")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>Нет активных тестов</p>
        }
    </section>

</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/chart-helper.js"></script>
<script>
    window.chartData = {
        dates: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDates)),
        values: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartTestsValues)),
        variantsValues: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartVariantsValues)),
        applicationsValues: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartApplicationsValues))
    };
</script>
<script src="~/js/index.js" asp-append-version="true"></script>