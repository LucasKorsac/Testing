@page
@model WebAppTest.Pages.IndexModel
@{
    ViewData["Title"] = "Главная";
}

<header>
    <nav>
        <ul>
            <!--  
            <li><a href="/Prof">Профиль</a></li> -->
            <li><a href="/Index">Главная страница</a></li>
            <li><a href="/Apps">Приложения</a></li>
            <li><a href="/TestControl">Управление</a></li>
            <li><a href="/Manage">Справка</a></li>

        </ul>
    </nav>
</header>

<main>

    <h1>Главная страница</h1>

    <!-- Аналитика -->

    <section>

        <h2>Аналитика</h2>

        <div class="stats-grid">

            <div class="stat-card">
                <span>Активные тесты</span>
                <strong>@Model.ActiveCount</strong>
            </div>

            <div class="stat-card">
                <span>Всего тестов</span>
                <strong>@Model.TotalTests</strong>
            </div>

            <div class="stat-card">
                <span>Всего вариантов</span>
                <strong>@Model.TotalVariants</strong>
            </div>

        </div>

    </section>

    <!-- График -->

    <section>

        <h2>Активность тестов</h2>

        <div class="chart-container">

            <canvas id="testsChart"></canvas>

        </div>

    </section>

    <!-- Активные тесты -->

    <section>

        <h2>Активные тесты</h2>

        @if (Model.ActiveTests.Any())
        {
            <div class="tests-list">

                @foreach (var t in Model.ActiveTests)
                {
                    <a class="test-item"
                       href="/Tests/@t.Key">

                        <div>

                            <strong>@t.Key</strong>

                            <p>
                                Выбранный вариант:
                                @t.Value
                            </p>

                        </div>

                    </a>
                }

            </div>
        }
        else
        {
            <p>Нет активных тестов</p>
        }

    </section>

</main>

<!-- index.js -->

<script src="https://cdn.jsdelivr.net/npm/index.js"></script>

<script>

    window.testsChartData = {labels: @Html.Raw(Json.Serialize(Model.ChartLabels)), values: @Html.Raw(Json.Serialize(Model.ChartValues))};

</script>

<script src="~/js/index.js"></script>