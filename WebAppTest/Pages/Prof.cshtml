@page
@model WebAppTest.Pages.ProfModel
@{
    ViewData["Title"] = "Профиль";
}

<header>
    <nav>
        <ul>
            <li><a href="/Prof">Профиль</a></li>
            <li><a href="/Index">Главная страница</a></li>
            <li><a href="/Apps">Приложения</a></li>
            <li><a href="/TestControl">Управление тестами</a></li>
            <li><a href="/Manage">Справка</a></li>

        </ul>
    </nav>
</header>

<main>

    <h1>Профиль</h1>

    <!-- Кнопка переключения режима -->
    <div style="margin-bottom: 10px;">
        @if (Model.Mode == "view")
        {
            <a href="/Prof?mode=edit" class="btn">
                Редактировать профиль
            </a>
        }
        else
        {
            <a href="/Prof?mode=view" class="btn">
                Отмена
            </a>
        }
    </div>

    <form method="post">

        <section class="profile">

            <img src="@Model.AvatarUrl" width="120" />

            <div>

                <label>Имя</label>
                <input asp-for="FirstName"
                       disabled="@(Model.Mode == "view")" />

                <label>Фамилия</label>
                <input asp-for="LastName"
                       disabled="@(Model.Mode == "view")" />

                <p>@Model.ProfileLink</p>

                @if (Model.Mode == "edit")
                {
                    <button type="submit" name="mode" value="edit">
                        Сохранить
                    </button>
                }

            </div>

        </section>

        <section>

            <h2>О себе</h2>

            <textarea asp-for="Description"
                      disabled="@(Model.Mode == "view")">
            </textarea>

        </section>

    </form>

</main>