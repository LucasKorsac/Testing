@page
@model WebAppTest.Pages.TestControlModel
@{
    ViewData["Title"] = "Управление";
}

<header>
    <nav>
        <ul>
            <li><a href="/Prof">Профиль</a></li>
            <li><a href="/Index">Главная страница</a></li>
            <li><a href="/TestControl">Управление</a></li>
            <li><a href="/Manage">Справка</a></li>
        </ul>
    </nav>
</header>

<main>

    <h1>Управление A/B тестами</h1>

    <section>

        <div class="actions">

            <button class="btn btn-primary">
                + Создать тест
            </button>

        </div>

    </section>

    <section>

        <h2>Список тестов</h2>

        @if (Model.Tests.Any())
        {
            @foreach (var test in Model.Tests)
            {
                <section class="test-card">

                    <!-- LEFT -->
                    <div class="test-info">

                        <h3>
                            <a href="/Tests/@test.Id?mode=view">
                                @test.Name
                            </a>
                        </h3>

                        <p class="test-description">
                            @test.Description
                        </p>

                        <span class="test-status @(test.Enabled ? "status-active" : "status-stopped")">
                            @(test.Enabled ? "Активен" : "Остановлен")
                        </span>

                    </div>

                    <!-- RIGHT -->
                    <div class="actions">

                        <a class="btn btn-secondary"
                           href="/Tests/@test.Id?mode=view">
                            Открыть
                        </a>

                        <a class="btn btn-primary"
                           href="/Tests/@test.Id?mode=edit">
                            Редактировать
                        </a>

                        <a class="btn btn-warning"
                           href="/Tests/@test.Id?mode=stop">
                            Остановить
                        </a>

                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-id="@test.Id">

                            <button class="btn btn-danger"
                                    type="submit"
                                    onclick="return confirm('Удалить тест?')">

                                Удалить

                            </button>

                        </form>

                    </div>

                </section>
            }
        }
        else
        {
            <p>Нет тестов</p>
        }

    </section>

</main>