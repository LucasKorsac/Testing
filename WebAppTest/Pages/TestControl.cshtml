@page
@model WebAppTest.Pages.TestControlModel

@{
    ViewData["Title"] = "Управление";
}

<header>
    <nav>
        <ul>
            <!-- <li><a href="/Prof">Профиль</a></li> -->
            <li><a href="/Index">Главная страница</a></li>
            <li><a href="/Apps">Приложения</a></li>
            <li><a href="/TestControl">Управление тестами</a></li>
            <li><a href="/Manage">Справка</a></li>

        </ul>
    </nav>
</header>

<main>

    <h1>Управление A/B тестами</h1>

    <!-- блок действий -->
    <section>

        <div class="actions">

            <button class="btn btn-primary">
                + Создать тест
            </button>

        </div>

    </section>

    <!-- список тестов -->
    <section>

        <h2>Список тестов</h2>

        @if (Model.Tests.Any())
        {
            @foreach (var test in Model.Tests)
            {
                <section class="test-card">

                    <!-- левая часть -->
                    <div class="test-info">

                        <h3>
                            <a asp-page="/Tests" asp-route-id="@test.Id">
                                @test.Name
                            </a>
                        </h3>

                        <p class="test-description">
                            @test.Description
                        </p>

                        <span class="test-status @(test.Enabled ? "status-active" : "status-stopped")">

                            @(test.Enabled ? "Активен" : "Остановлен")

                        </span>

                    </div>

                    <!-- правая часть -->
                    <div class="actions">

                        <!-- открыть -->
                        <a class="btn btn-secondary"
                           href="/Tests/@test.Id">

                            Открыть

                        </a>

                        <!-- редактирование -->
                        <a class="btn btn-primary"
                           href="/Tests/@test.Id?mode=edit">

                            Редактировать

                        </a>

                        <!-- остановка -->
                        @if (test.Enabled)
                        {
                            <form method="post"
                                  asp-page-handler="Stop"
                                  asp-route-id="@test.Id">

                                <button class="btn btn-warning"
                                        type="submit">

                                    Остановить

                                </button>

                            </form>
                        }
                        else
                        {
                            <!-- возобновление -->
                            <form method="post"
                                  asp-page-handler="Resume"
                                  asp-route-id="@test.Id">

                                <button class="btn btn-success"
                                        type="submit">

                                    Возобновить

                                </button>

                            </form>
                        }

                        <!-- удаление -->
                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-id="@test.Id">

                            <button class="btn btn-danger"
                                    type="submit"
                                    onclick="return confirm('Удалить тест?')">

                                Удалить

                            </button>

                        </form>

                    </div>

                </section>
            }
        }
        else
        {
            <p>Нет тестов</p>
        }

    </section>

</main>