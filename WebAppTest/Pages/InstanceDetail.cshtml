@page "{id}"
@model WebAppTest.Pages.InstanceDetail

@{
    ViewData["Title"] = "Экземпляр";
}

@section Styles {
    <link rel="stylesheet" href="~/css/charts.css" asp-append-version="true" />
}

@if (Model.Instance == null)
{
    <div class="empty-state">
        Экземпляр не найден
    </div>
}
else
{
    <main class="page-container">
        <section class="hero card">
            <div>
                <h1>@Model.Instance.Name</h1>
                <p class="description">Аналитика экземпляра приложения</p>
            </div>
            <div class="hero-stats">
                <div class="hero-card">
                    <span>Версия</span>
                    <strong>@Model.Instance.Version</strong>
                </div>
                <div class="hero-card">
                    <span>Дата</span>
                    <strong>@Model.Instance.Date.ToString("dd.MM.yyyy")</strong>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="chart-layout">
                <aside class="chart-sidebar">
                    <h3>Настройки</h3>
                    <label>Тип графика</label>
                    <select id="chartType">
                        <option value="bar">Столбчатый</option>
                        <option value="line">Линейный</option>
                        <option value="pie">Круговой</option>
                        <option value="doughnut">Кольцевой</option>
                    </select>
                    
                    <label>Метрика</label>
                    <select id="metricSelect">
                        <!-- Опции будут заполнены из API -->
                    </select>
                    
                    <button id="updateChartBtn" class="btn btn-primary btn-sm" style="margin-top: 16px;">Обновить</button>
                </aside>
                <div class="chart-wrapper">
                    <canvas id="metricsChart" style="width:100%; height:400px;"></canvas>
                </div>
            </div>
        </section>

        <section class="card">
            <h2>Детальная таблица метрик</h2>
            @if (Model.Table.Any())
            {
                <div class="table-scroll">
                    <table class="metrics-table" id="metricsTable">
                        <thead>
                            <tr>
                                <th>Установка</th>
                                <th>Кол-во вариантов</th>
                                <th>Вариант</th>
                                <th>Тип метрики</th>
                                <th>Значение</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Table)
                            {
                                <tr>
                                    <td>@row.InstallId</td>
                                    <td>@row.VariantsCount</td>
                                    <td>@row.VariantName</td>
                                    <td class="type-cell">@row.Type</td>
                                    <td class="value-cell" data-value="@row.NumericValue">@row.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">Нет данных для отображения</div>
            }
        </section>
    </main>
}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const instanceId = '@Model.Instance?.Id';

    document.addEventListener("DOMContentLoaded", function() {
        const chartTypeSelect = document.getElementById("chartType");
        const metricSelect = document.getElementById("metricSelect");
        const updateBtn = document.getElementById("updateChartBtn");
        const canvas = document.getElementById("metricsChart");
        const noDataMessage = document.getElementById("noDataMessage");

        if (!chartTypeSelect || !canvas) {
            console.error("Элементы не найдены");
            return;
        }

        let currentChart = null;
        let chartData = null;

        function showNoData() {
            if (currentChart) {
                currentChart.destroy();
                currentChart = null;
            }
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.font = "16px Arial";
            ctx.fillStyle = "#999";
            ctx.fillText("Нет данных для отображения", 50, 200);
        }

        function renderChart() {
            if (!chartData) {
                showNoData();
                return;
            }

            const selectedMetric = metricSelect?.value;
            if (!selectedMetric) {
                showNoData();
                return;
            }

            // Находим данные для выбранной метрики
            const metricData = chartData.find(item => item.metricName === selectedMetric);
            if (!metricData || !metricData.data || metricData.data.length === 0) {
                showNoData();
                return;
            }

            const labels = metricData.data.map(item => item.Value);
            const values = metricData.data.map(item => item.Frequency);

            if (currentChart) {
                currentChart.destroy();
            }

            const chartConfig = {
                type: chartTypeSelect.value,
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Частота",
                        data: values,
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        borderColor: 'rgb(54, 162, 235)',
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { position: 'top' },
                        title: { 
                            display: true, 
                            text: `Распределение значений метрики "${selectedMetric}"`,
                            font: { size: 14, weight: 'bold' }
                        }
                    },
                    scales: chartTypeSelect.value !== 'pie' && chartTypeSelect.value !== 'doughnut' ? {
                        x: {
                            title: { display: true, text: "Значения метрики" },
                            ticks: { maxRotation: 45 }
                        },
                        y: { 
                            beginAtZero: true, 
                            title: { display: true, text: "Частота" },
                            ticks: { stepSize: 1 }
                        }
                    } : {}
                }
            };

            currentChart = new Chart(canvas, chartConfig);
        }

        async function loadData() {
            if (!instanceId) {
                showNoData();
                return;
            }

            try {
                console.log("Загрузка данных экземпляра с API...");
                const response = await fetch(`/api/charts/instance/${instanceId}`);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                chartData = await response.json();
                console.log("Данные экземпляра получены:", chartData);
                
                // Заполняем выпадающий список метрик
                if (metricSelect && chartData && chartData.length > 0) {
                    metricSelect.innerHTML = '';
                    chartData.forEach(item => {
                        const option = document.createElement('option');
                        option.value = item.metricName;
                        option.textContent = item.metricName;
                        metricSelect.appendChild(option);
                    });
                    
                    // Выбираем первую метрику по умолчанию
                    if (chartData.length > 0) {
                        metricSelect.value = chartData[0].metricName;
                    }
                    
                    renderChart();
                } else {
                    showNoData();
                }
            } catch (error) {
                console.error("Ошибка загрузки данных:", error);
                showNoData();
            }
        }

        // Загружаем данные
        loadData();

        // Обработчики событий
        chartTypeSelect.addEventListener("change", renderChart);
        
        if (metricSelect) {
            metricSelect.addEventListener("change", renderChart);
        }
        
        if (updateBtn) {
            updateBtn.addEventListener("click", renderChart);
        }
    });
</script>