@page "{id}"
@model WebAppTest.Pages.InstanceDetail

@{
    ViewData["Title"] = "Экземпляр";
}

<header>
    <nav>
        <ul>
            <!--  <li><a href="/Prof">Профиль</a></li> -->
            <li><a href="/Index">Главная страница</a></li>
            <li><a href="/Apps">Приложения</a></li>
            <li><a href="/TestControl">Управление</a></li>
            <li><a href="/Manage">Справка</a></li>

        </ul>
    </nav>
</header>

@if (Model.Instance == null)
{
    <div class="alert alert-danger">
        Экземпляр не найден
    </div>

    return;
}

<h1>@Model.Instance.Name</h1>

<div class="mb-4">
    <p>
        <strong>Версия:</strong>
        @Model.Instance.Version
    </p>

    <p>
        <strong>Дата:</strong>
        @Model.Instance.Date.ToShortDateString()
    </p>
</div>

<h2 class="mb-3">Результаты A/B тестов</h2>

@if (Model.Table.Any())
{
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Пользователь</th>

                @foreach (var header in Model.Headers)
                {
                    <th>@header</th>
                }
            </tr>
        </thead>

        <tbody>
            @foreach (var row in Model.Table)
            {
                <tr>
                    <td>@row.User</td>

                    @foreach (var header in Model.Headers)
                    {
                        <td>
                            @(row.Values.ContainsKey(header)
                                            ? row.Values[header]
                                            : "-")
            </td>
                        }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-secondary">
        Нет результатов
    </div>
}