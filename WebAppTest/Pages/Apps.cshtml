@page
@model WebAppTest.Pages.Apps

@{
    ViewData["Title"] = "Приложения";
}

@section Styles {
    <link rel="stylesheet" href="~/css/apps.css" />
}

<main>

    <h1>Приложения</h1>

    @if (Model.AppsList.Any())
    {
        <div class="apps-grid">

            @foreach (var item in Model.AppsList)
            {
                <section class="app-card">

                    <h2>
                        @item.Application.Name
                    </h2>

                    <p>
                        @item.Application.Description
                    </p>

                    <label>
                        Экземпляры
                    </label>

                    <select onchange="
                                if(this.value)
                                window.location.href=this.value">

                        <option value="">
                            -- выбрать --
                        </option>

                        @foreach (var inst in item.Instances)
                        {
                            <option value="/InstanceDetail/@inst.Id">

                                @inst.Name
                                (v@inst.Version)

                            </option>
                        }

                    </select>

                    <br />
                    <br />

                    <form method="post"
                          asp-page-handler="Delete"
                          asp-route-id="@item.Application.Id">

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="
                                        return confirm(
                                            'Удалить приложение?')">

                            Удалить

                        </button>

                    </form>

                </section>
            }

        </div>
    }
    else
    {
        <p>Приложений нет</p>
    }

</main>