<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AB Testing</title>

    <!-- Основные стили  -->
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- библиотека для всплывающих уведомлений -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header>
        <div class="topbar">
            <div class="logo">
                AB Test logo
            </div>
            <nav>
                <ul>
                    <li><a href="/Index">Главная</a></li>
                    <li><a href="/Apps">Приложения</a></li>
                    <li><a href="/TestControl">Управление</a></li>
                    <li><a href="/Manage">Справка</a></li>
                    <li><a href="/Logout" class="logout-btn">Выйти</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <script>
        function showNotification(message, type = 'success') {
            Toastify({
                text: message,
                duration: 3000,
                gravity: "top",
                position: "right",
                className: `toastify-${type}`,
                style: {
                    borderRadius: '12px',
                    padding: '12px 20px'
                }
            }).showToast();
        }

        @if (TempData["SuccessMessage"] != null)
        {
                <text>showNotification('@TempData["SuccessMessage"]', 'success');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
                <text>showNotification('@TempData["ErrorMessage"]', 'error');</text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>