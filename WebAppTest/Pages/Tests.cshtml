@page "{id}"

@model WebAppTest.Pages.TestsModel

@using System.Text.Json

@{
    ViewData["Title"] = "Тест";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/charts.css"
          asp-append-version="true" />

}

<main class="page-container">

    <section class="hero card">

        <div>

            <h1>
                @Model.TestName
            </h1>

            <p class="description">
                @Model.Description
            </p>

            <span class="status-badge
                  @(Model.IsActive
                                      ? "status-active"
                                      : "status-stopped")">

                @(Model.IsActive
                                ? "Активен"
                                : "Остановлен")

            </span>

        </div>

    </section>

    <section class="stats-grid">

        @foreach (var row in Model.TableData)
        {
            <div class="stat-card">

                <span>@row.Key</span>

                <strong>@row.Value</strong>

            </div>
        }

    </section>

    <section class="card">

        <div class="chart-layout">

            <div class="chart-sidebar">

                <h3>Настройки</h3>

                <label>
                    Тип графика
                </label>

                <select id="chartType">

                    <option value="bar">
                        Bar
                    </option>

                    <option value="line">
                        Line
                    </option>

                    <option value="pie">
                        Pie
                    </option>

                    <option value="doughnut">
                        Doughnut
                    </option>

                </select>

                <label>
                    Показатель
                </label>

                <select id="chartMetric">

                    <option value="installs">
                        Установки
                    </option>

                    <option value="metrics">
                        Метрики
                    </option>

                </select>

            </div>

            <div class="chart-content">

                <h2>
                    Аналитика теста
                </h2>

                <div class="chart-container">

                    <canvas id="variantChart"></canvas>

                </div>

            </div>

        </div>

    </section>

    <section class="card">

        <div class="results-header">

            <div>

                <h2>
                    Результаты установок
                </h2>

                <p class="description">

                    Метрики по вариантам

                </p>

            </div>

            <div class="filter-box">

                <label>
                    Фильтр
                </label>

                <select id="variantFilter">

                    <option value="all">
                        Все варианты
                    </option>

                    @foreach (var variant
                                        in Model.VariantLabels)
                    {
                        <option value="@variant">
                            @variant
                        </option>
                    }

                </select>

            </div>

        </div>

        @if (Model.Results.Any())
        {
            <div class="table-scroll">

                <table class="metrics-table">

                    <thead>

                        <tr>

                            <th>Установка</th>

                            <th>Вариант</th>

                            <th>Тип метрики</th>

                            <th>Метрика</th>

                            <th>Значение</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var row in Model.Results)
                        {
                            <tr class="result-row"
                                data-variant="@row.VariantName">

                                <td>
                                    @row.InstallId
                                </td>

                                <td>
                                    @row.VariantName
                                </td>

                                <td>
                                    @row.MetricType
                                </td>

                                <td>
                                    @row.MetricName
                                </td>

                                <td>
                                    @row.Value
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <p>
                    Нет результатов
                </p>

            </div>
        }

    </section>

</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="~/js/chart-helper.js"></script>

<script>

    window.variantData = {

        labels:
            @Html.Raw(
                JsonSerializer.Serialize(
                        Model.ChartLabels)
                        ),

        installs:
            @Html.Raw(
                                JsonSerializer.Serialize(
                                        Model.ChartInstalls)
                        ),

        metrics:
            @Html.Raw(
                                JsonSerializer.Serialize(
                                        Model.ChartMetrics)
                        )
    };

</script>

<script src="~/js/tests.js"
        asp-append-version="true"></script>