@page "{id}"
@model WebAppTest.Pages.TestsModel
@using System.Text.Json

@{
    ViewData["Title"] = "Тест";
}

<header>
    <nav>
        <ul>
            <li><a href="/Index">Главная</a></li>
            <li><a href="/Apps">Приложения</a></li>
            <li><a href="/TestControl">Управление тестами</a></li>
            <li><a href="/Manage">Справка</a></li>
        </ul>
    </nav>
</header>

<main>

    <!-- Информация о тесте -->

    <section class="content-card">

        <h1>@Model.TestName</h1>

        <p>@Model.Description</p>

        <span class="status-badge @(Model.IsActive
                          ? "status-active"
                          : "status-stopped")">

            @(Model.IsActive ? "Активен" : "Остановлен")

        </span>

    </section>

    <!-- Таблица -->

    <section class="content-card">

        <h2>Информация о тесте</h2>

        <table class="metrics-table">

            <thead>
                <tr>
                    <th>Параметр</th>
                    <th>Значение</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var row in Model.TableData)
                {
                    <tr>
                        <td>@row.Key</td>
                        <td>@row.Value</td>
                    </tr>
                }

            </tbody>

        </table>

    </section>


    <!-- График -->


    <section class="content-card">

        <h2>Распределение пользователей</h2>

        <div class="chart-wrapper">

            <canvas id="variantChart"></canvas>

        </div>

    </section>

    <!--  Варианты -->

    <section class="content-card">

        <h2>Варианты теста</h2>

        <table class="metrics-table">

            <thead>
                <tr>
                    <th>Вариант</th>
                    <th>Пользователей</th>
                </tr>
            </thead>

            <tbody>

                @for (int i = 0; i < Model.VariantLabels.Count; i++)
                {
                    <tr>
                        <td>@Model.VariantLabels[i]</td>
                        <td>@Model.VariantValues[i]</td>
                    </tr>
                }

            </tbody>

        </table>

    </section>

    <div style="margin-top:20px;">

        <a class="btn btn-secondary"
           href="/TestControl">

            ← Назад

        </a>

    </div>

</main>

<!-- js -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    window.variantChartData = {

        labels:
            @Html.Raw(JsonSerializer.Serialize(Model.VariantLabels)),

        values:
            @Html.Raw(JsonSerializer.Serialize(Model.VariantValues))
    };

</script>

<script src="~/js/tests.js"></script>