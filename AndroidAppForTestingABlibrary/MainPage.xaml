<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyAbMobileApp.MainPage">

	<VerticalStackLayout
        Padding="30"
        Spacing="25">

		<Label
            Text="AB Test Demo"
            FontSize="28"
            HorizontalOptions="Center" />

		<Button
            Text="Initialize"
            Clicked="OnInitClicked" />

		<Button
            Text="Track Conversion"
            Clicked="OnTrackClicked" />

		<Label
            x:Name="VariantLabel"
            Text="Variant: unknown"
            FontSize="22" />

		<Label
            x:Name="StatusLabel"
            Text=""
            FontSize="18" />

	</VerticalStackLayout>

</ContentPage>